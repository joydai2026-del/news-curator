# Build output. The published page is produced by CI, not committed to main.
# (A CNAME for a custom domain lives at the repo ROOT, not here, and the build
# copies it into site/ on every run.)
site/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local probe receipts
receipt.json

# OS
.DS_Store

# Vault context symlink (house convention)
.vault

# Local pipeline artifacts (written by --health-report and workflow-local runs)
source-health.json
downloaded-state/
downloaded-translation/
repository-state/

# Filled-in Worker config. The example file carries placeholders only; the real
# copy holds the Access team name, the application audience tag, the private
# hostname and the zone name, none of which belong in a public repository.
/edge/wrangler.toml
/edge/.dev.vars

# Fixture generator scratch. regenerate-fixtures.mjs writes <fixture>.tmp-<pid>
# and renames it into place; the unlink cleanup is best-effort inside a catch,
# so a crash mid-generation can leave one behind. It is scratch, never an input.
/edge/fixtures/*.tmp-*
