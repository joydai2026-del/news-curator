  "payload": {
    "adapter_id": "vault-wiki",
    "adapter_version": "1.0.0",
    "eligible_artifact_types": [
      "question",
      "answer",
      "report",
      "insight",
      "save"
    ],
    "requires_approval": false,
    "supports_dry_run": true,
    "supports_readback": true,
    "publisher_identity_ref": "",
    "emits_public_content": false
  }
}
